{
  "name": "fangio",
  "version": "1.1.1",
  "private": true,
  "description": "Chromium extension (MV3) to archive tabs in a local database, close them safely and get them back fast.",
  "license": "GPL-3.0-only",
  "author": "TobiasCoding",
  "repository": {
    "type": "git",
    "url": "https://github.com/TobiasCoding/Fangio.git"
  },
  "type": "module",
  "homepage": "https://github.com/TobiasCoding/Fangio#readme",
  "bugs": {
    "url": "https://github.com/TobiasCoding/Fangio/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:views": "node e2e/views.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "release": "node scripts/release.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
