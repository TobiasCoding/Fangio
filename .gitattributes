# Normalize line endings: LF in the repository and working tree for source files.
* text=auto eol=lf

# Windows scripts must keep CRLF (cmd.exe requires it; PowerShell 5.1 prefers it).
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell scripts must stay LF even on Windows checkouts.
*.sh  text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.crx binary
